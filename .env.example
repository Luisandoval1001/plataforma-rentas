# Postgres local (scripts/db-local.sh start). La autenticación TCP en localhost usa
# scram-sha-256 (valor por defecto de Debian); `db-local.sh start` fija la contraseña
# del rol postgres a 'postgres' y crea el rol app_server con contraseña 'app_server'.
# El superusuario se alcanza por el socket Unix (peer) como usuario del SO "postgres".

# Conexión de la aplicación (rol app_server, sujeto a RLS)
DATABASE_URL=postgres://app_server:app_server@localhost:5432/rentas
# Conexión de migraciones / pruebas (superusuario)
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/rentas
# En producción/respaldos (scripts/backup.sh) usar el pooler de SESIÓN de Supabase (IPv4), no el de transacciones.

# Proveedores: local | supabase  (email: local | resend)
AUTH_PROVIDER=local
STORAGE_PROVIDER=local
EMAIL_PROVIDER=local

# Sólo para la instalación de demostración (datos ficticios): permite AUTH_PROVIDER=local en producción.
# MODO_DEMO=1
# Conexiones por instancia (por defecto 5)
# DB_POOL_MAX=5

# Secretos (generar valores aleatorios largos en producción)
SESSION_SECRET=change-me
CRON_SECRET=change-me

# Supabase (sólo con AUTH_PROVIDER/STORAGE_PROVIDER=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Correo (sólo con EMAIL_PROVIDER=resend)
RESEND_API_KEY=
EMAIL_FROM=DISA <no-reply@ctdisa.com>

# Overrides opcionales para los proveedores locales
# STORAGE_LOCAL_ROOT=./storage
# EMAIL_LOCAL_DIR=./tmp/emails

# URLs públicas: el enlace de acceso por correo regresa a <URL>/auth/callback (sólo de aquí,
# nunca de encabezados de la petición). El login elige APP_URL si se sirve desde ese host;
# en cualquier otro caso, CLIENTES_URL.
APP_URL=https://app.ctdisa.com
CLIENTES_URL=https://clientes.ctdisa.com

# Zona horaria: la app y la sesión de BD usan America/Mexico_City (ZONA_HORARIA en
# src/lib/formato.ts). En Vercel define también TZ=America/Mexico_City.
TZ=America/Mexico_City
